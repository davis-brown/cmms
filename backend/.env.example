# Copy to .env for local development: cp .env.example .env
# `npm run dev` loads this file. Every DB value below matches a stock local MySQL install.

PORT=8080

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=congregations
# Set to true to print every SQL query
DB_LOGGING=false

# Required. Any value works locally; production needs a long random one (openssl rand -hex 32)
JWT_SECRET=dev-secret

# Frontend URL(s) allowed to call the API, comma-separated
CORS_ORIGIN=http://localhost:8081

# Create a demo login (every role) and sample data on an empty database.
# Local development only: leave unset on any real server.
SEED_DEMO_DATA=true
DEMO_USERNAME=demo
DEMO_PASSWORD=demo1234
